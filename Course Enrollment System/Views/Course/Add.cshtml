@model Course_Enrollment_System.Models.Course
<link rel="stylesheet" href="~/css/site.css" />
<div><h2>Add Course Data</h2></div>
<div><p>Please fill in the following details to add a new course.</p></div>

<div>
     
    <form action="/Course/Add" method="post" id="CourseForm">
        <label for="CourseName">Course Name</label>
        <input type="text" id="CourseName" name="CourseName" /><br />
        <label for="Instructor">Instructor</label>
        <input type="text" id="Instructor" name="Instructor" /><br />
        <label for="Duration">Duration</label>
        <input type="number" id="Duration" name="Duration" /><br />
        <label for="Credits">Credits</label>
        <input type="number" id="Credits" name="Credits" /><br />
        <label for="Fee">Fee</label>
        <input type="number" id="Fee" name="Fee" /><br />
        <button type="submit">Add Course</button>
    </form>
    <script src="/js/site.js"></script>
</div>

