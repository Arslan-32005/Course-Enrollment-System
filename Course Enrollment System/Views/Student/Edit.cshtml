@model Course_Enrollment_System.Models.Student
<link rel="stylesheet" href="~/css/site.css" />
<div><h2>Edit Student Data</h2></div>
<div><p>Please fill in the following details to edit the student information.</p></div>
<div> 
    <form method="post" action="/Student/Edit/@Model.ID" id="StudentForm">
        <label for="Name">Name</label>
        <input type="text" name="Name" id="Name" value="@Model.Name" /><br />
        <label for="Age">Age</label>
        <input type="number" name="Age" id="Age" value="@Model.Age" /><br />
        <label for="Gender">Gender</label>
        <select name="Gender" id="Gender">
            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
            <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
        </select><br />
        <label for="ContactNumber">Contact Number</label>
        <input type="number" name="ContactNumber" id="ContactNumber" value="@Model.ContactNumber" /><br />
        <label for="Email">Email</label>
        <input type="email" name="Email" id="Email" value="@Model.Email" /><br />
        <label for="EnrollmentDate">Enrollment Date</label>
        <input type="date" name="EnrollmentDate" id="EnrollmentDate" value="@Model.EnrollmentDate" /><br />
        <button type="submit">Edit Student</button>

</form>
    <script src="/js/site.js"></script>
</div>
